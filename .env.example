# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# --- Público (vai para o navegador) ---
NEXT_PUBLIC_CONTACT_EMAIL=contato@thecinematic.chef
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `npx supabase status` mostra estes valores no ambiente local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Só servidor ---
SUPABASE_SECRET_KEY=

# Tradução no admin e Chef IA (API do Claude)
ANTHROPIC_API_KEY=
# Fase 2 — perguntas por assinante por dia no Chef IA (padrão 30)
CHEF_DAILY_LIMIT=30

# Etapa 3 e 4 — Mux (upload no admin, player e URLs assinadas)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=

# Etapa 6 — pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs dos Prices (USD) criados no Stripe para os planos mensal e anual
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
