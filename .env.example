# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# --- Público (vai para o navegador) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `npx supabase status` mostra estes valores no ambiente local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Só servidor ---
SUPABASE_SECRET_KEY=

# Etapa 3 — tradução no admin
ANTHROPIC_API_KEY=

# Etapa 4 — Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Etapa 6 — pagamentos
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
